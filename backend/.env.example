# =============================================================================
# BidSmart Analytics — Environment Variables Template (.env.example)
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials to version control.
# =============================================================================

# Project Metadata
PROJECT_NAME="BidSmart Analytics API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication (JWT)
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL Database Configuration
MYSQL_SERVER="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="bidsmart_user"
MYSQL_PASSWORD="replace_with_your_mysql_password"
MYSQL_DB="bidsmart_db"

# SQLAlchemy Connection Pool Configuration
# PRD requirement: Support 20+ simultaneous pooled connections
MYSQL_POOL_SIZE=20
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=30
MYSQL_POOL_RECYCLE=1800
MYSQL_ECHO=False

# Cross-Origin Resource Sharing (CORS)
# Comma-separated or JSON array of allowed origins
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Optional AI Assistant Configuration
# Leave blank to use deterministic offline fallback engine
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Background Auction Scheduler
# Enable or disable the periodic background auction closing loop (default: True)
ENABLE_AUCTION_SCHEDULER=True
ENABLE_SELLER_PAYMENT_SETUP=False
# How often (in seconds) the scheduler polls for and closes expired auctions.
# Default: 30 seconds — safe for Aiven free-tier connection limits.
# Decrease (e.g. 10) for faster auction closing in staging/dev environments.
# This variable is optional — the default of 30 is coded into Settings.
SCHEDULER_INTERVAL_SECONDS=30
